# Root .dockerignore — applies to the API and ingestion builds
# (build context = repository root, used by docker/Dockerfile.api and
# docker/Dockerfile.ingestion).

# VCS
.git
.github
.claude

# Python caches / artifacts
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.coverage
**/.venv
**/*.egg-info
build
dist

# Environment
.env
.env.*
!.env.example

# Node / Next (not needed by api/ingestion images)
node_modules
**/node_modules
**/.next
**/test-results
**/playwright-report
**/coverage
**/*.tsbuildinfo
services/frontend

# Placeholder shared packages (no runtime value in these images) — but their
# manifests must enter the build context: the uv workspace definition in the
# root pyproject.toml requires all member pyprojects for `uv sync --frozen`.
packages/contracts/**
!packages/contracts/pyproject.toml
packages/config/**
!packages/config/pyproject.toml

# Tests and fixtures (not shipped in runtime images)
**/tests
