# PostgreSQL (docker-compose weather_postgres + API/ingestion services)
POSTGRES_USER=weather_user
POSTGRES_PASSWORD=weather_password
POSTGRES_DB=weather_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://weather_user:weather_password@localhost:5432/weather_db

# Redis (docker-compose weather_redis + API cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# MinIO (docker-compose weather_minio + ingestion/API Zarr store)
# NOTE: docker-compose reads MINIO_ROOT_USER/MINIO_ROOT_PASSWORD and binds the
# host side of the port mapping via MINIO_PORT. The API/ingestion services read
# MINIO_ACCESS_KEY/MINIO_SECRET_KEY/MINIO_ENDPOINT (a full host:port the S3
# client connects to) and MINIO_SECURE. Both are listed; the two variables have
# distinct meanings.
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_password
MINIO_ENDPOINT=localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_SECURE=false
MINIO_BUCKET_NAME=weather-data

# Ingestion worker (NOAA NOMADS connector)
NOMADS_BASE_URL=https://nomads.ncep.noaa.gov
NOAA_USER_AGENT=weather-platform-ingestion/0.1.0
REQUEST_TIMEOUT_SECONDS=30.0
DOWNLOAD_RETRIES=3
RETRY_BACKOFF_SECONDS=1.0
# Bounded concurrency for parallel fetch/decode/region-commit per run (CLI
# --concurrency, default 4). GEFS ingests gep01..gep30 concurrently.
# INGESTION_CONCURRENCY=4

# Opt-in MinIO/S3 integration tests (default off)
WEATHER_TEST_MINIO=0

# Location place-autocomplete provider (Google Places API (New) by default).
# The API key/token lives server-side and is never exposed to the browser.
SEARCH_PROVIDER=google
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_API_BASE=https://places.googleapis.com/v1
GOOGLE_PLACES_REGION=
GOOGLE_PLACES_TIMEOUT=5.0
MAPBOX_TOKEN=

# Elevation resolution (local/server-side DEM by default).
#   dem    -> api/services/elevation.py reads a local Copernicus 30m DEM store
#             (see DEM_DATA_PATH). The provider + rounded-coordinate cache are
#             created once per process and reused across requests.
#   google -> Google Elevation API (ToS restricts caching; not the default)
#   none   -> elevation always unavailable
ELEVATION_PROVIDER=dem
# Path/URL of the DEM store: a global xarray-readable Zarr/NetCDF with
# latitude/longitude coords and an ``elevation`` variable in meters. The
# operator places the downloaded Copernicus 30m DEM data here (prepared into a
# Zarr/NetCDF store). Empty means no DEM configured -> elevation unavailable.
DEM_DATA_PATH=
ELEVATION_CACHE_MAX=4096
ELEVATION_CACHE_DISABLED=false
