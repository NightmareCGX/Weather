# PostgreSQL (docker-compose weather_postgres + API/ingestion services)
POSTGRES_USER=weather_user
POSTGRES_PASSWORD=weather_password
POSTGRES_DB=weather_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://weather_user:weather_password@localhost:5432/weather_db

# Redis (docker-compose weather_redis + API cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# MinIO (docker-compose weather_minio + ingestion/API Zarr store)
# NOTE: docker-compose reads MINIO_ROOT_USER/MINIO_ROOT_PASSWORD and binds the
# host side of the port mapping via MINIO_PORT. The API/ingestion services read
# MINIO_ACCESS_KEY/MINIO_SECRET_KEY/MINIO_ENDPOINT (a full host:port the S3
# client connects to) and MINIO_SECURE. Both are listed; the two variables have
# distinct meanings.
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_password
MINIO_ENDPOINT=localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_SECURE=false
MINIO_BUCKET_NAME=weather-data

# Ingestion worker (NOAA connector)
# Primary upstream provider for operational NOAA products ("aws_s3" or "nomads").
# Defaults to AWS Open Data on S3 to avoid NOMADS rate limiting. The AWS base
# URLs below are the buckets used for downloads AND (Phase 5B) anonymous
# ListObjectsV2 publication discovery.
NOAA_DOWNLOAD_SOURCE=aws_s3
AWS_GFS_BASE_URL=https://noaa-gfs-bdp-pds.s3.amazonaws.com
AWS_GEFS_BASE_URL=https://noaa-gefs-pds.s3.amazonaws.com
NOMADS_BASE_URL=https://nomads.ncep.noaa.gov
NOAA_USER_AGENT=weather-platform-ingestion/0.1.0
REQUEST_TIMEOUT_SECONDS=30.0
DOWNLOAD_RETRIES=3
RETRY_BACKOFF_SECONDS=1.0
# Automatic NOMADS fallback when AWS S3 returns 404 (publication lag) or 5xx.
ENABLE_NOMADS_FALLBACK=true
# Selective .idx byte-range downloading (>97% bandwidth saving; full-file fallback).
ENABLE_SELECTIVE_DOWNLOAD=true
# Bounded concurrency for parallel fetch/decode/region-commit per run (CLI
# --concurrency, default 4). GEFS ingests gep01..gep30 concurrently.
# INGESTION_CONCURRENCY=4

# Opt-in MinIO/S3 integration tests (default off)
WEATHER_TEST_MINIO=0

# Location place-autocomplete provider (Geoapify by default for V1).
# The API key/token lives server-side and is never exposed to the browser.
SEARCH_PROVIDER=geoapify
GEOAPIFY_API_KEY=
LOCATIONIQ_API_KEY=
SEARCH_PRIMARY_TIMEOUT_MS=2000
SEARCH_FALLBACK_TIMEOUT_MS=1500
SEARCH_CIRCUIT_BREAKER_FAILURES=2
SEARCH_CIRCUIT_BREAKER_COOLDOWN_S=60
SEARCH_CACHE_TTL_SECONDS=300
# Coarse IP geolocation for the startup map viewport (/v1/locate).
#
# Source 1 — infrastructure headers (Cloudflare Managed Transforms), for origins
# served through Cloudflare with "Add visitor location headers" enabled.
# Default false: externally supplied headers are NEVER trusted unless explicitly
# enabled on an origin that is firewalled to Cloudflare.
TRUST_CLOUDFLARE_LOCATION_HEADERS=false
#
# Source 2 — a local GeoLite2 database, for self-hosted origins with no CDN in
# front (docs/DEPLOYMENT.md §7 covers provisioning and the monthly refresh).
#   none    (default) /v1/locate answers 404 and the map keeps its CONUS default
#   maxmind resolve the visitor address against LOCATE_GEOIP_DB_PATH
# The reader is memory-mapped: resident cost is the pages actually touched
# (a few MB), shared across the uvicorn workers, and the file is reopened
# automatically when a refresh replaces it — no API restart needed.
LOCATE_PROVIDER=none
LOCATE_GEOIP_DB_PATH=/data/geoip/GeoLite2-City.mmdb
# How the visitor address is read off the request:
#   auto   (default) trust the gateway's X-Real-IP only when the socket peer is
#          not a routable address — true for anything arriving through the
#          gateway, while a caller hitting the published API port directly keeps
#          its own address instead of a forged one.
#   always trust X-Real-IP unconditionally (only when the API port is firewalled
#          to the gateway)
#   never  always use the socket peer (every visitor then resolves to the
#          gateway's own location, i.e. the datacenter)
LOCATE_PROXY_MODE=auto
#
# Host directory mounted read-only at /data/geoip in the API container.
GEOIP_DATA_DIR=./data/geoip
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_API_BASE=https://places.googleapis.com/v1
GOOGLE_PLACES_REGION=
GOOGLE_PLACES_TIMEOUT=5.0
MAPBOX_TOKEN=

# Elevation resolution for dynamic coordinates (UI display metadata only).
#   none       -> elevation always unavailable (safe offline default; 0 external calls)
#   open_meteo -> Open-Meteo Elevation API (Copernicus GLO-90 90m DEM)
ELEVATION_PROVIDER=open_meteo
ELEVATION_BASE_URL=https://api.open-meteo.com/v1/elevation
ELEVATION_API_KEY=
ELEVATION_TIMEOUT_SECONDS=2.0
ELEVATION_CACHE_MAX=10000
ELEVATION_CACHE_DISABLED=false

# --- Zarr region-write concurrency (reader gate / advisory locks) ---
# The API serving tier participates in the SHARED PostgreSQL store gate when
# reading forecast Zarr stores so it never observes a store mid-re-ingest.
# API_MAX_CONCURRENT_GATED_READS bounds concurrent gated reads PER PROCESS
# (multiply by UVICORN_WORKERS for the fleet); excess requests wait rather than
# consuming a reader-lock connection.
API_MAX_CONCURRENT_GATED_READS=16
API_READER_LOCK_POOL_SIZE=16
API_READER_LOCK_MAX_OVERFLOW=8
API_READER_LOCK_POOL_TIMEOUT_SECONDS=5.0
API_READER_GATE_TIMEOUT_SECONDS=30.0
API_SHUTDOWN_DRAIN_TIMEOUT_SECONDS=40.0

# s3fs connection pool per cached ShardedV1Reader (see MAX_READERS in
# api/core/zarr.py — each reader holds its own client, so this multiplies).
# The ingestion-only S3_MAX_POOL_CONNECTIONS does NOT apply to the API.
API_S3_MAX_POOL_CONNECTIONS=16

# Chunk-cache ceiling per reader, in 100x100 float32 chunks (~40 KB each), so this
# multiplies straight into memory: 512 ~ 20 MB per reader, 2048 ~ 82 MB. Measured
# on a realistic session, the LRU hit rate plateaus at 1024 entries; 512 costs one
# percentage point for a 4x memory reduction.
API_READER_MAX_CACHED_CHUNKS=512

# Shard-index ceiling per reader, in whole shard index trailers (the 120-chunk
# (offset, length) index of one variable/member/lead shard). An 80-lead ensemble
# series resolves ~4.8k indexes for wind and ~14.4k for 3-hour precipitation, so a
# ceiling that holds one series makes every later click on that cycle skip its index
# fetches. Entries are stored as a (120, 2) uint64 array (~2 KB measured) rather than
# a Python tuple list (~14 KB), so 16384 entries is ~32 MB per reader versus ~57 MB
# for the previous hardcoded 4096. Multiplies by MAX_READERS (8) per process.
API_READER_MAX_CACHED_INDICES=16384

# Interpolated 2x2 corner ceiling per reader (~0.8 KB per entry measured, so ~25 MB
# at 32768). Bilinear interpolation needs only four corner values, but the chunk
# cache above is keyed by whole 100x100 chunks, so 512 chunk entries cover 512
# variable/member/lead combinations while one 80-lead precipitation series needs
# 14400. 32768 covers more than two complete series for about one chunk cache's
# worth of memory, and a hit skips the index lookup, chunk fetch and zstd decode.
API_READER_MAX_CACHED_POINTS=32768

# Map-tile PNG (IDAT) zlib compression level, 0-9. Level 1 is the serving
# default: on a 256x256 RGBA tile it compresses several times faster than the
# zlib default of 6 for only a small size increase, which shortens the
# cold-tile CPU phase during a viewport burst.
API_PNG_COMPRESS_LEVEL=1

# --- Serving read fan-out (per API process) ---
# Multiply by UVICORN_WORKERS to get the fleet-wide thread count, and remember
# every fetched shard chunk also costs CPU to zstd-decode. The defaults are the
# measured saturation points on the deployed topology (4-core ARM64 shared with
# Postgres/Redis/MinIO/ingestion, 4 uvicorn workers, API container ~93% of a
# 4 GiB memory limit) — larger pools were measurably SLOWER there.
API_CHUNK_FETCH_WORKERS=2
# A single GEFS point read fans out over up to 30 members; the win saturates at 4.
API_MEMBER_FETCH_WORKERS=4
# Wind U/V component fetch fan-out per API process (reused pool avoids per-tile thread churn).
API_WIND_FETCH_WORKERS=2

# Ingestion wave pre-update marker-PUT concurrency / timeout.
MARKER_PUT_CONCURRENCY=8
MARKER_PUT_TIMEOUT_SECONDS=30.0

# Ingestion Database Connection Pool & Stage Backpressure (P1 Scalability)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30.0

# Ingestion Stage Concurrency (Conservative Code Defaults)
WEATHER_INGEST_DOWNLOAD_CONCURRENCY=8
WEATHER_INGEST_DECODE_CONCURRENCY=2
WEATHER_INGEST_WRITE_CONCURRENCY=4
WEATHER_INGEST_MARKER_PUT_CONCURRENCY=32
WEATHER_INGEST_MARKER_GET_CONCURRENCY=32

# Optional High-Performance Deployment Profile (Benchmark per deployment):
# WEATHER_INGEST_DOWNLOAD_CONCURRENCY=16
# WEATHER_INGEST_DECODE_CONCURRENCY=8
# WEATHER_INGEST_WRITE_CONCURRENCY=6
# WEATHER_INGEST_MARKER_PUT_CONCURRENCY=32
# WEATHER_INGEST_MARKER_GET_CONCURRENCY=64

# Ingestion S3 Client Connection Pool (P2 Phase 1)
#
# INGESTION TIER ONLY. The API tier ignores this variable and uses
# API_S3_MAX_POOL_CONNECTIONS (see the API serving section above); because the two
# tiers commonly share one .env, setting this to tune the API has no effect. The API
# logs a startup warning when this name is present without an explicit
# API_S3_MAX_POOL_CONNECTIONS.
S3_MAX_POOL_CONNECTIONS=50

# --- Serving Availability & Degraded Coverage Policy (Phase 3) ---
# Minimum ensemble member coverage ratio required for lead- and cell-level serving
# eligibility. Constrained to (0.0, 1.0]; default is 0.85 (85% member coverage).
ENSEMBLE_MIN_COVERAGE_RATIO=0.85

# --- Realtime lead-wave scheduler (Phase 5C) ---
# Opt-in master switch for `weather-ingest realtime`. Big-batch ingestion
# never reads these settings. The canonical lead horizon is a product contract
# (domain.horizon), deliberately NOT configurable here.
REALTIME_ENABLED=false
# Normal active poll cadence while tracking a cycle (seconds).
REALTIME_ACTIVE_POLL_SECONDS=600
# Fast poll cadence while upstream publication activity is observed (seconds).
REALTIME_PUBLICATION_POLL_SECONDS=120
# Idle backoff after polls with no publication activity; doubles per idle
# poll up to the maximum (seconds).
REALTIME_IDLE_BACKOFF_INITIAL_SECONDS=1800
REALTIME_IDLE_BACKOFF_MAX_SECONDS=3600
# Relative jitter applied to poll intervals (± fraction, [0.0, 1.0)).
REALTIME_POLL_JITTER_FRACTION=0.10
# Bounded wave batching: emit a wave when this many complete pending leads
# accumulated OR the oldest pending lead waited this long (seconds).
REALTIME_WAVE_MAX_LEADS=8
REALTIME_WAVE_MAX_WAIT_SECONDS=1200
# Retry delay after a discovery failure (never treated as "upstream idle").
REALTIME_DISCOVERY_FAILURE_RETRY_SECONDS=60
# Delay after a cycle's nominal time before auto-selection probes it (seconds).
REALTIME_FIRST_PUBLICATION_DELAY_SECONDS=10800
# Normal fill time granted to a cycle after its f000 ingest anchor
# (model_runs.created_at) before monitoring counts it as lagging (seconds).
# Derived from the wave parameters: ceil(81 / REALTIME_WAVE_MAX_LEADS) *
# REALTIME_ACTIVE_POLL_SECONDS = 11 * 600s, budgeted as 2h + 30min margin.
# Recompute if REALTIME_WAVE_MAX_LEADS or REALTIME_ACTIVE_POLL_SECONDS change.
INGESTION_FILL_IN_GRACE_SECONDS=9000
# Backlog catch-up: consecutive failures before a candidate cycle is
# quarantined instead of retried forever, and how long the quarantine lasts
# (seconds; 0 holds it until the cycle's serving horizon expires).
REALTIME_BACKLOG_FAILURE_QUARANTINE_THRESHOLD=5
REALTIME_BACKLOG_QUARANTINE_SECONDS=0

# ---------------------------------------------------------------------------
# Ensemble aggregate storage (phase-in)
# ---------------------------------------------------------------------------
# When true, each committed ensemble member's variables are additionally written to a
# staging area (__staging__/v1/<variable>/). A lead's staging is aggregated into one
# statistic object per variable (<variable>/shard.agg_L####.shard) when the lead settles,
# and the staging it consumed is then dropped.
#
# Default FALSE, and NOT merely because the aggregates are new: **enabling it now costs
# storage rather than saving it.** The aggregate is written alongside the member shards, and
# nothing reclaims the members it replaces — target_kind has no "agg", the GC planner builds
# its physical units from det/mean/mem only, and canonical selection has no aggregate concept.
# Measured on real GEFS members, one variable x one lead becomes members + aggregate:
#
#     temperature_2m            25.49 MB + 17.60 MB = 43.09 MB   (1.69x)
#     precipitation_amount_3h   16.56 MB + 17.96 MB = 34.52 MB   (2.08x)
#
# The saving the whole design exists for requires member shards to become reclaimable, per
# variable, once an aggregate replaces them — and that cannot be done for the four variables
# whose products are functions of the per-member values (wind_10m, precipitation_amount_3h,
# cloud_ceiling, cloud_cover_3h), nor while include_members=true must still serve raw members.
# Until that replacement exists, this switch is a storage increase, not a saving. See
# docs/investigations/numeric-encoding/IMPLEMENTATION.md section 19.8.
ENSEMBLE_STAGING_ENABLED=false
# Staging namespace version segment. Bump only alongside a staging layout change; it lets a
# new layout coexist with in-flight waves instead of requiring a quiesce.
ENSEMBLE_STAGING_VERSION=v1
# Settlement: how a lead's aggregate gets published.
#
# A lead publishes as soon as its whole expected member set is committed. If the set stalls
# short of that, a first version publishes anyway once member coverage reaches
# ENSEMBLE_MIN_COVERAGE_RATIO and no new member has arrived for ENSEMBLE_SETTLEMENT_QUIET_SECONDS;
# every later arrival restarts the window and produces one more patch. A lead stops being
# patched when its full set arrives or the wave finishes it. Each publication advances the
# store's manifest generation, which is what makes a patch visible to the API and the tiles.
#
# A publication of an unchanged member set is suppressed: it would be byte-identical content
# behind a generation bump, and a generation bump invalidates the response cache and the tile
# LRU for the whole store, so a long stall would flush caches on a timer for no new data.
ENSEMBLE_SETTLEMENT_QUIET_SECONDS=600.0
# Leads that may aggregate concurrently. One by default: each aggregate pass holds a whole
# variable's member stack, so raising this multiplies peak residency rather than throughput.
ENSEMBLE_SETTLEMENT_WORKERS=1


# ---------------------------------------------------------------------------
# Edge gateway (docker compose --profile gateway): optional HTTP/2 + TLS
# reverse proxy. Routes /v1/* to the API tier directly and everything else to
# the Next.js frontend. Upstreams default to host-run services.
# ---------------------------------------------------------------------------
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443
# Container-reachable addresses of the API and frontend. Containerized
# deployments override these with compose service DNS names, e.g.
# GATEWAY_API_UPSTREAM=weather_api:8000
GATEWAY_API_UPSTREAM=host.docker.internal:8000
GATEWAY_FRONTEND_UPSTREAM=host.docker.internal:3000
