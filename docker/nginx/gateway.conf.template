# Weather platform edge gateway (HTTP/2 + TLS termination, single origin).
#
# Rendered at container startup from this template by the nginx image's
# envsubst mechanism: only ${...} references that name a *defined* environment
# variable are substituted (API_UPSTREAM / FRONTEND_UPSTREAM), so nginx
# runtime variables such as $host or $remote_addr pass through untouched.
#
# Routing:
#   /v1/*  -> FastAPI serving tier directly (single hop: tile/point/vector
#             requests skip the Next.js proxy entirely)
#   /*     -> Next.js frontend (SSR pages, static assets, dev HMR websocket)
#
# Browsers only negotiate HTTP/2 over TLS, so the gateway terminates TLS on
# :443 and HTTP on :80 redirects to it. Upstream keepalive pools reuse
# connections instead of paying TCP setup per tile.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream weather_api {
    server ${API_UPSTREAM};
    keepalive 32;
}

upstream weather_frontend {
    server ${FRONTEND_UPSTREAM};
    keepalive 32;
}

# Tile cache backed by tmpfs (RAM mount): 4GB max, 1h inactive eviction.
# use_temp_path=off avoids disk copies by writing directly into the cache hierarchy.
proxy_cache_path /var/cache/nginx/tiles levels=1:2 keys_zone=tile_cache:32m max_size=4g inactive=1h use_temp_path=off;

server {
    listen 80;
    server_name _;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/tls.crt;
    ssl_certificate_key /etc/nginx/certs/tls.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1h;

    # Gzip compression for large JSON payloads (e.g. /v1/forecast/availability).
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types application/json application/javascript text/css text/plain application/xml text/xml application/x-font-ttf font/opentype image/svg+xml;
    gzip_min_length 1024;

    # Proxy buffer tuning to prevent large JSON responses (e.g. 444KB availability)
    # from buffering to disk temporary files (/var/cache/nginx/proxy_temp/).
    proxy_buffers 16 64k;
    proxy_buffer_size 64k;
    proxy_busy_buffers_size 128k;

    # Point forecast / probability POST bodies stay small, but keep headroom.
    client_max_body_size 10m;

    # Web-Mercator forecast raster tiles: cached in tmpfs RAM for 1h.
    # Pinned tile URLs (with initial_time) are immutable and served at microsecond latency from RAM.
    location ~ ^/v1/maps/.+\.png$ {
        proxy_pass http://weather_api;
        proxy_http_version 1.1;
        # Empty Connection header enables upstream keepalive reuse.
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_cache tile_cache;
        proxy_cache_key "$request_uri";
        proxy_cache_lock on;
        proxy_cache_lock_timeout 5s;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;

        proxy_cache_valid 200 1h;
        proxy_cache_revalidate on;

        add_header X-Cache-Status $upstream_cache_status;
    }

    # Ensemble statistics: a cold time-series request reads every ensemble member
    # shard for every lead (a single point series is ~4.4k shard range GETs for
    # wind and ~15k for 3-hour precipitation), so it takes far longer than the 60s
    # nginx default for proxy_read_timeout. That default fires while waiting for
    # the response header and surfaces to the browser as a 504, which the frontend
    # renders in place of the ensemble fan chart. This block must stay ahead of the
    # generic /v1/ prefix location; scoping the longer timeout here (rather than on
    # /v1/) keeps every other endpoint failing fast on a real hang.
    location ~ ^/v1/ensembles {
        proxy_pass http://weather_api;
        proxy_http_version 1.1;
        # Empty Connection header enables upstream keepalive reuse.
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location /v1/ {
        proxy_pass http://weather_api;
        proxy_http_version 1.1;
        # Empty Connection header enables upstream keepalive reuse.
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        proxy_pass http://weather_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # WebSocket upgrade (Next.js dev HMR); harmless in production.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
