# Milestone 14 — Ingestion worker production image
#
# Multi-stage build for the one-shot ingestion CLI (weather-ingest).
#   - builder: installs runtime deps (per the committed services/ingestion
#     poetry.lock) into an in-project venv.
#   - runtime: python:3.12-slim, non-root, copies the self-contained venv +
#     ingestion source; entrypoint is the `weather-ingest` console script.
#
# This is a CLI container, not a daemon. Orchestration passes the args, e.g.:
#   docker run <image> ingest --model gfs --cycle-date 2026-07-21 --cycle-hour 0 \
#       --lead-time-hours 6 --store s3://weather-data/gfs/2026-07-21/00/cycle.zarr
#
# Default CMD `--help` prints usage and exits 0 — a dependency-free smoke.
#
# Build context: repository root (docker build -f docker/Dockerfile.ingestion .)

# syntax=docker/dockerfile:1
FROM python:3.12-slim AS builder
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    POETRY_VERSION=2.4.1 \
    POETRY_VIRTUALENVS_IN_PROJECT=true \
    POETRY_NO_INTERACTION=1
RUN python -m pip install --no-cache-dir "poetry==${POETRY_VERSION}"
WORKDIR /app

# 1) Manifests (committed lockfile -> reproducible install).
COPY services/ingestion/pyproject.toml services/ingestion/poetry.lock /app/services/ingestion/
# weather-platform-domain is a local path dependency of the ingestion package
# (services/ingestion/pyproject.toml -> ../../packages/domain, i.e. /app/packages/domain
# in the image). It must be present before `poetry install` so Poetry can resolve
# and install the path dependency for the main dependency group.
COPY packages/domain/pyproject.toml /app/packages/domain/
COPY packages/domain/src /app/packages/domain/src
RUN cd /app/services/ingestion && poetry install --only main --no-root

# 2) Add the ingestion source, install the root package (creates the
#    `weather-ingest` console script entrypoint).
COPY services/ingestion/src /app/services/ingestion/src
RUN cd /app/services/ingestion && poetry install --only main

FROM python:3.12-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/services/ingestion/.venv/bin:$PATH"
WORKDIR /app
# cfgrib needs the native ecCodes C library to decode GRIB2. The `eccodes`
# Python wheel bundles the native library only on Windows (see
# ci.yml ingestion-tests comment); on Linux the pure-Python wheel requires the
# system libeccodes, exactly as CI installs. Install the Debian package that
# provides the runtime `libeccodes.so` so the production image can decode GRIB.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libeccodes-dev \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --system --create-home --uid 1001 appuser
COPY --from=builder /app/services/ingestion/.venv /app/services/ingestion/.venv
# Ship the domain source consumed by the ingestion worker (the same path
# dependency installed into the venv). Matches the runtime stage's style used
# for the ingestion source below.
RUN mkdir -p /app/packages/domain
COPY --chown=appuser:appuser --from=builder /app/packages/domain/src /app/packages/domain/src
COPY --from=builder /app/services/ingestion/src /app/services/ingestion/src
USER appuser
WORKDIR /app/services/ingestion
ENTRYPOINT ["weather-ingest"]
CMD ["--help"]
