# Milestone 14 — Ingestion worker production image
#
# Multi-stage build for the one-shot ingestion CLI (weather-ingest).
#   - builder: installs runtime deps from the single root uv.lock (including
#     the weather-platform-domain workspace member, built as a non-editable
#     wheel via --no-editable) into an in-project venv.
#   - runtime: python:3.12-slim, non-root, copies the self-contained venv +
#     ingestion source; entrypoint is the `weather-ingest` console script.
#
# This is a CLI container, not a daemon. Orchestration passes the args, e.g.:
#   docker run <image> ingest --model gfs --cycle-date 2026-07-21 --cycle-hour 0 \
#       --lead-time-hours 6 --store s3://weather-data/gfs/2026-07-21/00/cycle.zarr
#
# Default CMD `--help` prints usage and exits 0 — a dependency-free smoke.
#
# Build context: repository root (docker build -f docker/Dockerfile.ingestion .)

# syntax=docker/dockerfile:1
FROM python:3.12-slim AS builder
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    # Pin the project environment path: uv's environment discovery must not
    # wander to a workspace-root .venv — the runtime stage copies THIS venv.
    UV_PROJECT_ENVIRONMENT=/app/services/ingestion/.venv
COPY --from=ghcr.io/astral-sh/uv:0.12.13 /uv /usr/local/bin/uv
WORKDIR /app

# 1) Workspace manifests + the single root lock. The whole workspace must be
#    present (all member pyprojects) for uv to resolve; domain's source is
#    needed because uv builds its wheel as a workspace dependency. Deps only:
#    the ingestion project itself is deferred to the second sync so manifest
#    edits invalidate this cache layer without touching source.
COPY pyproject.toml uv.lock /app/
COPY packages/domain/pyproject.toml /app/packages/domain/pyproject.toml
COPY packages/config/pyproject.toml /app/packages/config/pyproject.toml
COPY packages/contracts/pyproject.toml /app/packages/contracts/pyproject.toml
COPY services/api/pyproject.toml /app/services/api/pyproject.toml
COPY services/ingestion/pyproject.toml /app/services/ingestion/pyproject.toml
COPY packages/domain/src /app/packages/domain/src/
RUN cd /app/services/ingestion && uv sync --frozen --no-dev --no-editable --no-install-project

# 2) Add the ingestion source, then install the ingestion project itself
#    non-editable (creates the `weather-ingest` console script entrypoint).
COPY services/ingestion/src /app/services/ingestion/src
RUN cd /app/services/ingestion && uv sync --frozen --no-dev --no-editable

FROM python:3.12-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/services/ingestion/.venv/bin:$PATH"
WORKDIR /app
# cfgrib needs the native ecCodes C library to decode GRIB2. The `eccodes`
# Python wheel bundles the native library only on Windows (see
# ci.yml ingestion-tests comment); on Linux the pure-Python wheel requires the
# system libeccodes, exactly as CI installs. Install the Debian package that
# provides the runtime `libeccodes.so` so the production image can decode GRIB.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libeccodes-dev \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --system --create-home --uid 1001 appuser
COPY --from=builder /app/services/ingestion/.venv /app/services/ingestion/.venv
# Ship the domain source consumed by the ingestion worker (the same workspace
# dependency installed into the venv). Matches the runtime stage's style used
# for the ingestion source below.
RUN mkdir -p /app/packages/domain
COPY --chown=appuser:appuser --from=builder /app/packages/domain/src /app/packages/domain/src
COPY --from=builder /app/services/ingestion/src /app/services/ingestion/src
USER appuser
WORKDIR /app/services/ingestion
ENTRYPOINT ["weather-ingest"]
CMD ["--help"]
