# Milestone 14 — API production image
#
# Multi-stage build for the FastAPI serving tier.
#   - builder: installs runtime deps (incl. the weather-platform-domain path
#     dependency source, which Poetry builds as a non-editable wheel) into an
#     in-project venv.
#   - runtime: python:3.12-slim, non-root, copies the self-contained venv +
#     API source + Alembic migrations.
#
# Build context: repository root (docker build -f docker/Dockerfile.api .)
#
# Runtime configuration (DATABASE_URL, REDIS_URL, MINIO_*, ...) is read from
# the process environment by api.core.config.Settings (pydantic BaseSettings);
# no image-time wiring needed.

# syntax=docker/dockerfile:1
FROM python:3.12-slim AS builder
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    POETRY_VERSION=2.4.1 \
    POETRY_VIRTUALENVS_IN_PROJECT=true \
    POETRY_NO_INTERACTION=1
RUN python -m pip install --no-cache-dir "poetry==${POETRY_VERSION}"
WORKDIR /app

# 1) Manifests + the domain path-dependency source (Poetry builds a wheel of it
#    during install; the lock marks it non-editable -> self-contained venv).
COPY services/api/pyproject.toml services/api/poetry.lock /app/services/api/
# domain/src contains a single `domain/` subdir; copy it into the expected
# `src/` path so Poetry finds the package at src/domain (PEP 517 build).
COPY packages/domain/pyproject.toml /app/packages/domain/pyproject.toml
COPY packages/domain/src /app/packages/domain/src/
RUN cd /app/services/api && poetry install --only main --no-root

# 2) Add the API source (incl. Alembic migrations), install the root package
#    (creates the `api` dist + the weather-platform-api entry).
COPY services/api /app/services/api
RUN cd /app/services/api && poetry install --only main

FROM python:3.12-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/services/api/.venv/bin:$PATH"
WORKDIR /app
RUN useradd --system --create-home --uid 1001 appuser
COPY --from=builder /app/services/api/.venv /app/services/api/.venv
COPY --from=builder /app/services/api/src /app/services/api/src
COPY --from=builder /app/services/api/alembic /app/services/api/alembic
COPY --from=builder /app/services/api/alembic.ini /app/services/api/alembic.ini
USER appuser
WORKDIR /app/services/api
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/docs', timeout=5).status==200 else 1)"
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
