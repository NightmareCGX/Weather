# Milestone 14 — API production image
#
# Multi-stage build for the FastAPI serving tier.
#   - builder: installs runtime deps from the single root uv.lock (including
#     the weather-platform-domain workspace member, built as a non-editable
#     wheel via --no-editable) into an in-project venv.
#   - runtime: python:3.12-slim, non-root, copies the self-contained venv +
#     API source + Alembic migrations.
#
# Build context: repository root (docker build -f docker/Dockerfile.api .)
#
# Runtime configuration (DATABASE_URL, REDIS_URL, MINIO_*, ...) is read from
# the process environment by api.core.config.Settings (pydantic BaseSettings);
# no image-time wiring needed.

# syntax=docker/dockerfile:1
FROM python:3.12-slim AS builder
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    # Pin the project environment path: uv's environment discovery must not
    # wander to a workspace-root .venv — the runtime stage copies THIS venv.
    UV_PROJECT_ENVIRONMENT=/app/services/api/.venv
COPY --from=ghcr.io/astral-sh/uv:0.12.13 /uv /usr/local/bin/uv
WORKDIR /app

# 1) Workspace manifests + the single root lock. The whole workspace must be
#    present (all member pyprojects) for uv to resolve; domain's source is
#    needed because uv builds its wheel as a workspace dependency. Deps only:
#    the api project itself is deferred to the second sync so manifest edits
#    invalidate this cache layer without touching source.
COPY pyproject.toml uv.lock /app/
COPY packages/domain/pyproject.toml /app/packages/domain/pyproject.toml
COPY packages/config/pyproject.toml /app/packages/config/pyproject.toml
COPY packages/contracts/pyproject.toml /app/packages/contracts/pyproject.toml
COPY services/api/pyproject.toml /app/services/api/pyproject.toml
COPY services/ingestion/pyproject.toml /app/services/ingestion/pyproject.toml
COPY packages/domain/src /app/packages/domain/src/
RUN cd /app/services/api && uv sync --frozen --no-dev --no-editable --no-install-project

# 2) Add the API source (incl. Alembic migrations), then install the api
#    project itself non-editable (self-contained venv for the runtime stage).
COPY services/api /app/services/api
RUN cd /app/services/api && uv sync --frozen --no-dev --no-editable

FROM python:3.12-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/services/api/.venv/bin:$PATH"
WORKDIR /app
RUN useradd --system --create-home --uid 1001 appuser
COPY --from=builder /app/services/api/.venv /app/services/api/.venv
COPY --from=builder /app/services/api/src /app/services/api/src
COPY --from=builder /app/services/api/alembic /app/services/api/alembic
COPY --from=builder /app/services/api/alembic.ini /app/services/api/alembic.ini
USER appuser
WORKDIR /app/services/api
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/docs', timeout=5).status==200 else 1)"
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
