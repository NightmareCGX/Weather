# --- Python bytecode / caches ---
__pycache__/
*.py[cod]
.cache/

# --- Tool caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Test & coverage artifacts ---
.coverage
.coverage.*
htmlcov/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Environment files ---
# .env.example stays tracked; only real/secret env files are ignored.
.env
.env.*
!.env.example

# Poetry local config
poetry.toml

# --- Editors / IDEs ---
.vscode/
.idea/

# --- Packaging / build artifacts ---
build/
dist/
*.egg-info/

# --- OS / misc ---
.DS_Store
Thumbs.db

# --- Logs / temp files ---
*.log
*.tmp
*.bak

# --- cfgrib / eccodes index cache artifacts ---
# cfgrib writes a per-GRIB2 "*.idx" file next to the source when decoding;
# it embeds an absolute path and is regenerated deterministically on demand.
*.idx

# --- Node.js / Next.js (Milestone 12) ---
# package-lock.json is intentionally NOT ignored: it is committed so npm
# installs are reproducible.
node_modules/
.next/
out/
coverage/
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Playwright E2E (Milestone 13) ---
test-results/
playwright-report/
blob-report/
playwright/.cache/
