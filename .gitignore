# --- Python bytecode / caches ---
__pycache__/
*.py[cod]
.cache/

# --- Tool caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Test & coverage artifacts ---
.coverage
.coverage.*
htmlcov/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Environment files ---
# .env.example stays tracked; only real/secret env files are ignored.
.env
.env.*
!.env.example

# Poetry local config
poetry.toml

# --- Editors / IDEs ---
.vscode/
.idea/

# --- Packaging / build artifacts ---
build/
dist/
*.egg-info/

# --- OS / misc ---
.DS_Store
Thumbs.db

# --- Logs / temp files ---
*.log
*.tmp
*.bak
